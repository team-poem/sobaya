#!/bin/bash
set -eu
root=$(cd "$(dirname "$0")/.." && pwd -P)
if [ "${1:-}" = config ]; then
  if [ "$#" -ne 4 ] || [ "$2" != check ] || [ "$3" != --root ]; then
    printf '%s\n' 'Usage: sobaya config check --root PATH' >&2; exit 2
  fi
  exec /bin/bash "$root/tdd-set/lib/config-check.sh" "$4"
fi
exec /bin/bash "$root/tdd-set/lib/installed.sh" "$@"
